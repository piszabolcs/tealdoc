<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
    <AssemblyName>TealDocAiTool</AssemblyName>
    <Authors>Pintér Szabolcs</Authors>
    <Product>TealDoc</Product>
    <!-- Az EGYETLEN verzióforrás: a láblécben és a névjegyben futásidőben innen olvassuk. -->
    <Version>1.0.0</Version>
    <Copyright>Copyright 2026 Pintér Szabolcs</Copyright>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="NPOI" Version="2.8.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\App.ico" />
    <Resource Include="Assets\Logo_icon.png" />
    <Resource Include="Assets\Logo_nobg.png" />
  </ItemGroup>

</Project>

